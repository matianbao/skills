{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TikZ Diagram Description",
  "description": "Structured description for academic paper architecture diagrams. Used by tikz_generator.py to produce TikZ code with automatic layout and collision detection.",
  "type": "object",
  "required": ["caption", "label", "nodes", "edges"],
  "properties": {
    "caption": {
      "type": "string",
      "description": "LaTeX caption text for the figure"
    },
    "label": {
      "type": "string",
      "description": "LaTeX label (e.g. fig:framework)",
      "pattern": "^fig:"
    },
    "layout": {
      "type": "string",
      "enum": ["bottom-to-top", "left-to-right"],
      "default": "bottom-to-top"
    },
    "double_column": {
      "type": "boolean",
      "default": true,
      "description": "Use figure* (double column) environment"
    },
    "scale": {
      "type": "number",
      "default": 0.75,
      "minimum": 0.3,
      "maximum": 1.0
    },
    "layout_config": {
      "type": "object",
      "properties": {
        "row_gap": { "type": "number", "default": 1.5, "description": "Vertical gap between rows (cm)" },
        "col_gap": { "type": "number", "default": 3.2, "description": "Horizontal gap between columns (cm)" },
        "inter_group_gap": { "type": "number", "default": 0.6, "description": "Extra gap between group boundaries (cm)" }
      }
    },
    "styles": {
      "type": "object",
      "description": "Override default fill colors per node type",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "fill": { "type": "string", "description": "TikZ fill color (e.g. blue!10)" }
        }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label", "row", "col"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique node identifier (used in edges and TikZ \\node)",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
          },
          "label": {
            "type": "string",
            "description": "Display text. Use \\\\ for line breaks. LaTeX math OK."
          },
          "type": {
            "type": "string",
            "enum": ["input", "encoder", "core", "output", "loss", "prediction", "frozen", "gate", "norm", "pool", "concat", "module"],
            "default": "module",
            "description": "Node type → determines default fill color and min_width"
          },
          "group": {
            "type": "string",
            "description": "Group ID this node belongs to (for dashed stage boxes)"
          },
          "row": {
            "type": "integer",
            "description": "Logical row (0 = bottom). Nodes in the same row share Y coordinate."
          },
          "col": {
            "type": "integer",
            "description": "Logical column. Nodes in the same column share X coordinate."
          },
          "col_span": {
            "type": "integer",
            "default": 1,
            "minimum": 1,
            "description": "Span multiple columns (node centered across them)"
          },
          "dim": {
            "type": "string",
            "description": "Dimension annotation (e.g. $\\R^{128}$)"
          },
          "dim_pos": {
            "type": "string",
            "enum": ["above", "below", "left", "right"],
            "default": "above"
          },
          "min_width": {
            "type": "number",
            "description": "Override minimum width (cm)"
          },
          "min_height": {
            "type": "number",
            "description": "Override minimum height (cm)"
          },
          "fill": {
            "type": "string",
            "description": "Override fill color for this specific node"
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to"],
        "properties": {
          "from": {
            "type": "string",
            "description": "Source node ID"
          },
          "to": {
            "oneOf": [
              { "type": "string" },
              { "type": "array", "items": { "type": "string" }, "minItems": 2 }
            ],
            "description": "Target node ID, or array for fork (one-to-many)"
          },
          "style": {
            "type": "string",
            "enum": ["default", "fork", "residual", "dashed", "signal", "bidirectional"],
            "default": "default",
            "description": "default=solid arrow, fork=one-to-many, residual=dashed skip connection, signal=red dashed, bidirectional=double-headed arrow"
          }
        }
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Group ID (referenced by nodes' group field)"
          },
          "label": {
            "type": "string",
            "description": "Stage label text (e.g. Stage 1: Tokenization)"
          },
          "style": {
            "type": "string",
            "enum": ["dashed", "solid"],
            "default": "dashed"
          }
        }
      }
    },
    "zoom_in": {
      "type": "object",
      "description": "Optional zoom-in detail sub-diagram",
      "properties": {
        "target_node": { "type": "string", "description": "Node ID to connect the zoom box to" },
        "position": { "type": "string", "enum": ["left", "right"], "default": "right" },
        "label": { "type": "string" },
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "label"],
            "properties": {
              "id": { "type": "string" },
              "label": { "type": "string" },
              "fill": { "type": "string" },
              "x_offset": { "type": "number", "default": 0 }
            }
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["from", "to"],
            "properties": {
              "from": { "type": "string" },
              "to": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
